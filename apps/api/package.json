{
  "name": "@saas-o-matic/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc -p tsconfig.config.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.config.json",
    "test": "pnpm test:unit && pnpm test:integration",
    "db:generate": "tsc -p tsconfig.config.json && drizzle-kit generate && node scripts/finalize-migrations.mjs",
    "db:migrate": "node dist/db/cli.js migrate",
    "db:demo:setup": "node dist/db/cli.js demo:setup",
    "db:demo:init": "node dist/db/cli.js demo:init",
    "db:seed": "node dist/db/cli.js seed",
    "db:backup": "node dist/db/cli.js backup",
    "test:unit": "node --test test/tax-id.test.mjs test/customers-contract.test.mjs test/tax-policy.test.mjs test/simulations-contract.test.mjs",
    "test:integration": "node --test test/health.test.mjs test/database.test.mjs test/database-operations.test.mjs test/customers.test.mjs test/server-lifecycle.test.mjs test/simulations-service.test.mjs test/simulations.test.mjs test/simulations-history.test.mjs test/billing-config.test.mjs test/demo-setup.test.mjs"
  },
  "dependencies": {
    "@saas-o-matic/shared": "workspace:*",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.4",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.20.6"
  }
}
