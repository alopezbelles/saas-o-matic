{
  "name": "@saas-o-matic/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:node && pnpm test:components",
    "test:node": "pnpm --filter @saas-o-matic/shared build && tsc -p tsconfig.test.json && node --test test/*.test.mjs",
    "test:components": "vitest run"
  },
  "dependencies": {
    "@saas-o-matic/shared": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "27.0.1",
    "vite": "^8.0.0",
    "vitest": "5.1.0"
  }
}
