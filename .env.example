# Variable opcional de la API. El arranque no necesita archivo .env.
# PowerShell: $env:PORT = '3000'; pnpm.cmd dev:api
# POSIX: PORT=3000 pnpm dev:api
# Para cargar un archivo explícitamente en Node 22, usar --env-file.
PORT=3000

# La API y los comandos DB usan estas variables; no hay carga automática.
DATABASE_PATH=apps/api/data/dev.sqlite
DATABASE_KIND=development
