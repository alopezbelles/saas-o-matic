{
  "name": "saas-o-matic",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @saas-o-matic/web --filter @saas-o-matic/api dev",
    "dev:web": "pnpm --filter @saas-o-matic/web dev",
    "dev:api": "pnpm --filter @saas-o-matic/api dev",
    "build": "pnpm -r build",
    "start:api": "pnpm --filter @saas-o-matic/api start",
    "typecheck": "pnpm --filter @saas-o-matic/shared build && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:integration && pnpm test:web && pnpm test:gates && pnpm test:docs",
    "test:integration": "pnpm --filter @saas-o-matic/api... build && pnpm --filter @saas-o-matic/api test",
    "test:web": "pnpm --filter @saas-o-matic/web build && pnpm --filter @saas-o-matic/web test",
    "test:gates": "node --test test/gates.test.mjs",
    "test:docs": "node --test test/docs.test.mjs",
    "db:generate": "pnpm --filter @saas-o-matic/shared build && pnpm --filter @saas-o-matic/api db:generate",
    "db:migrate": "pnpm --filter @saas-o-matic/api... build && pnpm --filter @saas-o-matic/api db:migrate",
    "db:demo:init": "pnpm --filter @saas-o-matic/api... build && pnpm --filter @saas-o-matic/api db:demo:init",
    "db:seed": "pnpm --filter @saas-o-matic/api... build && pnpm --filter @saas-o-matic/api db:seed",
    "db:backup": "pnpm --filter @saas-o-matic/api... build && pnpm --filter @saas-o-matic/api db:backup"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
